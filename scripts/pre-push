#!/usr/bin/env bash
# Pre-push hook: fmt, clippy, tests.
# Installed via scripts/install-hooks.sh.
# Skip with: git push --no-verify

set -euo pipefail

echo "remit pre-push: cargo fmt --check..."
cargo fmt --all -- --check

echo "remit pre-push: cargo clippy..."
cargo clippy --workspace --all-targets -- -D warnings

echo "remit pre-push: cargo test..."
cargo test --workspace

echo "remit pre-push: all checks passed."
